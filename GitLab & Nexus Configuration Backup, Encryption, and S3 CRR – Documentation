4. Script Execution
gitlab__backup_to_s3_checksum.sh


#!/bin/bash
set -euo pipefail

# ================= CONFIG =================
GitLab_Node="Prod-Rails-2" ## add node name here
friendlyname="$(hostname -s)"

BASE_DIR="/home/alm-gitlab-bkp"
S3_BUCKET="s3--crr-frankfurt"
S3_PREFIX="frankfurt-config/gitlab-node-backups"
S3_REGION="eu-central-1"

SECRETS_REGION="eu-central-1"
SECRET_NAME="gitlab-file-encryption-password"

CHECKSUM_FILE="$BASE_DIR/last-backup.checksum"

# ================= CHECK FOR CHANGES =================
echo "Checking for changes in GitLab configuration files..."

CURRENT_SUM=$(tar -cf - \
  /etc/gitlab/gitlab.rb \
  /etc/gitlab/gitlab-secrets.json \
  /etc/gitlab/ssl \
  /etc/gitlab/trusted-certs \
  /etc/ssh/ssh_host_*_key* \
  /etc/fstab \
  2>/dev/null | sha256sum | awk '{print $1}')

if [[ -f "$CHECKSUM_FILE" ]]; then
    LAST_SUM=$(cat "$CHECKSUM_FILE")

    if [[ "$CURRENT_SUM" == "$LAST_SUM" ]]; then
        echo "No changes detected. Skipping backup."
        exit 0
    fi
fi

echo "Changes detected — proceeding with backup."

# ================= CONTINUE WITH BACKUP =================
myDate=$(date '+%Y-%m-%d_%H-%M-%S')
bkp_dir="${GitLab_Node}_${myDate}__${friendlyname}"
BACKUP_PATH="$BASE_DIR/$bkp_dir"

ARCHIVE="$BASE_DIR/${bkp_dir}.tar.gz"
ENCRYPTED_ARCHIVE="${ARCHIVE}.enc"

# ================= CREATE DIRECTORIES =================
mkdir -p "$BACKUP_PATH/gitLab" "$BACKUP_PATH/ssl" "$BACKUP_PATH/trusted-certs" "$BACKUP_PATH/ssh" "$BACKUP_PATH/fstab"

# ================= COPY FILES =================
cp -p /etc/gitlab/gitlab-secrets.json "$BACKUP_PATH/gitLab/"
cp -p /etc/gitlab/gitlab.rb "$BACKUP_PATH/gitLab/"
cp -p /etc/fstab "$BACKUP_PATH/fstab/"
cp -pr /etc/gitlab/ssl "$BACKUP_PATH/"
cp -pr /etc/gitlab/trusted-certs "$BACKUP_PATH/"
cp -pr /etc/ssh/ssh_host_*_key* "$BACKUP_PATH/ssh/"

# ================= CREATE ARCHIVE =================
tar -czvf "$ARCHIVE" -C "$BASE_DIR" "$bkp_dir"

# ================= FETCH PASSWORD =================
export no_proxy="169.254.169.254"
export https_proxy=http://10.169.127.8:8080/
export http_proxy=http://10.169.127.8:8080/

PASSWORD=$(/usr/local/bin/aws secretsmanager get-secret-value \
  --region "$SECRETS_REGION" \
  --secret-id "$SECRET_NAME" \
  --query SecretString \
  --output text)

# ================= ENCRYPT ARCHIVE =================
printf "%s" "$PASSWORD" | openssl enc -aes-256-cbc -pbkdf2 -salt \
  -in "$ARCHIVE" \
  -out "$ENCRYPTED_ARCHIVE" \
  -pass stdin

unset PASSWORD

# ================= UPLOAD TO S3 =================
/usr/local/bin/aws s3 cp "$ENCRYPTED_ARCHIVE" \
  "s3://$S3_BUCKET/$S3_PREFIX/$(basename "$ENCRYPTED_ARCHIVE")" \
  --region "$S3_REGION"

echo "GitLab backup completed successfully: $(basename "$ENCRYPTED_ARCHIVE")"

# ================= SAVE NEW CHECKSUM =================
echo "$CURRENT_SUM" > "$CHECKSUM_FILE"


decrypt_s3_file.sh


#!/bin/bash
set -euo pipefail

# ================= CONFIG =================
S3_BUCKET="s3--crr-frankfurt"   # Test ENV s3 bucket name- s3-crr-frankfurt
S3_PREFIX="frankfurt-config/gitlab-node-backups"
S3_REGION="eu-central-1"

SECRETS_REGION="eu-central-1"
SECRET_NAME="gitlab-file-encryption-password"

# ================= INPUT CHECK =================
if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <encrypted-backup-file-name.enc>"
    echo "Example:"
    echo "  $0 Test-Rails-2_2026-01-08_08-16-01__ip-10-110-108-24.tar.gz.enc"
    exit 1
fi

ENCRYPTED_FILE="$1"
LOCAL_ENC_FILE="$(basename "$ENCRYPTED_FILE")"
DECRYPTED_FILE="${LOCAL_ENC_FILE%.enc}"

echo "Downloading encrypted backup from S3..."
/usr/local/bin/aws s3 cp \
  "s3://${S3_BUCKET}/${S3_PREFIX}/${LOCAL_ENC_FILE}" \
  "./${LOCAL_ENC_FILE}" \
  --region "$S3_REGION"

export no_proxy="169.254.169.254"
export https_proxy=http://10.169.127.8:8080/
export http_proxy=http://10.169.127.8:8080/

echo "Fetching decryption password from AWS Secrets Manager..."
PASSWORD=$(/usr/local/bin/aws secretsmanager get-secret-value \
  --region "$SECRETS_REGION" \
  --secret-id "$SECRET_NAME" \
  --query SecretString \
  --output text)

echo "Decrypting backup..."
printf "%s" "$PASSWORD" | openssl enc -d -aes-256-cbc -pbkdf2 \
  -in "$LOCAL_ENC_FILE" \
  -out "$DECRYPTED_FILE" \
  -pass stdin

unset PASSWORD

echo "Extracting decrypted archive..."
tar -xzvf "$DECRYPTED_FILE"

echo "Decryption and extraction complete."
echo "Backup directory restored from: $DECRYPTED_FILE"


